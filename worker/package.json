{
  "name": "assay-provider-verify-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-code Cloudflare Worker that verifies Assay request signatures and forwards valid requests to your origin.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "pretest": "npm --prefix ../node run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "predry-run": "npm --prefix ../node run build",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@goassay-ai/provider-verify": "file:../node"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.147.0"
  }
}
